 "confirmation": {
  "subject": "Confirme seu e-mail no Mostralo",
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirme seu e-mail</title></head>\n<body style=\"margin:0;padding:0;background:#F4F1EE;font-family:Arial,Helvetica,sans-serif;color:#1F2937\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Falta só um clique para ativar sua conta.</div>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"background:#F4F1EE\">\n<tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"max-width:560px\">\n<tr><td align=\"center\" style=\"padding:0 0 20px\">\n<a href=\"https://mostralo.com.br\" style=\"text-decoration:none\"><img src=\"https://mostralo.com.br/icon-192.png\" width=\"48\" height=\"48\" alt=\"Mostralo\" style=\"display:inline-block;vertical-align:middle;border:0;border-radius:12px\">\n<span style=\"display:inline-block;vertical-align:middle;margin-left:10px;font-size:24px;font-weight:800;color:#D96F26;letter-spacing:-0.5px\">Mostralo</span></a>\n</td></tr>\n<tr><td style=\"background:#ffffff;border-radius:16px;border-top:5px solid #D96F26;padding:36px 32px 32px\">\n<h1 style=\"margin:0 0 16px;font-size:22px;line-height:30px;color:#1F2937;text-align:center\">Confirme seu e-mail</h1>\n<p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#1F2937;text-align:center\">Que bom ter você no Mostralo! 🧡</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#1F2937;text-align:center\">Para ativar sua conta <strong>{{ .Email }}</strong>, confirme seu e-mail no botão abaixo.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px auto 8px\">\n<tr><td align=\"center\" bgcolor=\"#D96F26\" style=\"border-radius:10px\">\n<a href=\"{{ .ConfirmationURL }}\" target=\"_blank\" style=\"display:inline-block;padding:15px 34px;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;font-family:Arial,Helvetica,sans-serif\">Confirmar meu e-mail</a>\n</td></tr></table><p style=\"margin:18px 0 0;font-size:12px;line-height:18px;color:#6B7280;text-align:center\">Se o botão não funcionar, copie e cole este endereço no navegador:<br>\n<a href=\"{{ .ConfirmationURL }}\" style=\"color:#B85A1B;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n</td></tr>\n<tr><td align=\"center\" style=\"padding:20px 8px 0;font-size:12px;line-height:18px;color:#6B7280\">\nSe não foi você que pediu, pode ignorar este e-mail com segurança.<br><br>\n<strong style=\"color:#D96F26\">Mostralo</strong> · Faz tudo para o seu negócio crescer<br>\n<a href=\"https://mostralo.com.br\" style=\"color:#6B7280\">mostralo.com.br</a> · Este é um e-mail automático, não responda.\n</td></tr>\n</table></td></tr></table></body></html>"
 },
 "invite": {
  "subject": "Você foi convidado para o Mostralo",
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Você foi convidado 🎉</title></head>\n<body style=\"margin:0;padding:0;background:#F4F1EE;font-family:Arial,Helvetica,sans-serif;color:#1F2937\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Aceite o convite e crie sua senha.</div>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"background:#F4F1EE\">\n<tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"max-width:560px\">\n<tr><td align=\"center\" style=\"padding:0 0 20px\">\n<a href=\"https://mostralo.com.br\" style=\"text-decoration:none\"><img src=\"https://mostralo.com.br/icon-192.png\" width=\"48\" height=\"48\" alt=\"Mostralo\" style=\"display:inline-block;vertical-align:middle;border:0;border-radius:12px\">\n<span style=\"display:inline-block;vertical-align:middle;margin-left:10px;font-size:24px;font-weight:800;color:#D96F26;letter-spacing:-0.5px\">Mostralo</span></a>\n</td></tr>\n<tr><td style=\"background:#ffffff;border-radius:16px;border-top:5px solid #D96F26;padding:36px 32px 32px\">\n<h1 style=\"margin:0 0 16px;font-size:22px;line-height:30px;color:#1F2937;text-align:center\">Você foi convidado 🎉</h1>\n<p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#1F2937;text-align:center\">Você recebeu um convite para acessar o painel do Mostralo com o e-mail <strong>{{ .Email }}</strong>.</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#1F2937;text-align:center\">Clique abaixo para aceitar e criar sua senha.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px auto 8px\">\n<tr><td align=\"center\" bgcolor=\"#D96F26\" style=\"border-radius:10px\">\n<a href=\"{{ .ConfirmationURL }}\" target=\"_blank\" style=\"display:inline-block;padding:15px 34px;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;font-family:Arial,Helvetica,sans-serif\">Aceitar convite</a>\n</td></tr></table><p style=\"margin:18px 0 0;font-size:12px;line-height:18px;color:#6B7280;text-align:center\">Se o botão não funcionar, copie e cole este endereço no navegador:<br>\n<a href=\"{{ .ConfirmationURL }}\" style=\"color:#B85A1B;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n</td></tr>\n<tr><td align=\"center\" style=\"padding:20px 8px 0;font-size:12px;line-height:18px;color:#6B7280\">\nSe você não esperava este convite, pode ignorar este e-mail.<br><br>\n<strong style=\"color:#D96F26\">Mostralo</strong> · Faz tudo para o seu negócio crescer<br>\n<a href=\"https://mostralo.com.br\" style=\"color:#6B7280\">mostralo.com.br</a> · Este é um e-mail automático, não responda.\n</td></tr>\n</table></td></tr></table></body></html>"
 },
 "magic_link": {
  "subject": "Seu acesso ao Mostralo",
